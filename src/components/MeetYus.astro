---
import site from '../data/site.json';
import T from './T.astro';
import Media from './Media.astro';
const { vehicles } = Astro.props as { vehicles: any[] };
const y = site.yus;
const a = site.advisor;
const loc = y.location;
---
<section id="yus" data-ctx class="py-24 md:py-40">
  <div class="wrap">
    <!-- ── Block 1: Yus ───────────────────────────────────────────────
         Mobile order: heading → portrait → details
         Desktop: portrait left (spans 2 rows), heading + details right -->
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-10 md:gap-y-0">
      <header class="md:col-span-6 md:col-start-7 md:row-start-1 md:pt-6">
        <p class="label mb-5 text-sm"><span class="text-lime">- </span><T value={y.label} /></p>
        <h2 class="title-xl yus-title reveal">
          {y.lines.map((l) => <span class="max-md:inline md:block"><T value={l} />{' '}</span>)}
        </h2>
      </header>

      <figure class="md:col-span-5 md:col-start-1 md:row-span-2 md:row-start-1">
        <div class="relative">
          <Media
            src={y.portrait}
            alt={y.portraitAlt}
            label={`Yus portrait — ${y.portrait}`}
            eager={true}
            class="reveal-img aspect-[4/5] w-full"
          />
          <!-- Name plate over the photo -->
          <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 via-ink/50 to-transparent p-5 pt-16 md:p-6 md:pt-20">
            <p class="font-display text-3xl md:text-4xl">{a.name}</p>
            <p class="mt-1 text-sm text-paper/80"><T value={a.role} /></p>
          </div>
        </div>
        <figcaption class="label mt-3 text-center text-[0.625rem]">{a.company} · {a.location}</figcaption>
      </figure>

      <div class="md:col-span-6 md:col-start-7 md:row-start-2 md:self-end">
        <p class="max-w-md text-muted md:text-lg"><T value={y.intro} /></p>

        <div class="mt-10 grid grid-cols-2 gap-6 border-t border-white/10 pt-6 sm:gap-8">
          <div>
            <h3 class="label mb-3"><T value={y.modelsLabel} /></h3>
            <ul class="font-display text-lg">
              {vehicles.map((v) => <li><a href={`#${v.slug}`} class="inline-flex min-h-10 items-center hover:text-lime">{v.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h3 class="label mb-3"><T value={y.servicesLabel} /></h3>
            <ul>
              {y.services.map((s) => (
                <li class="flex min-h-10 items-center gap-3 text-sm uppercase tracking-[0.1em]">
                  <span aria-hidden="true" class="size-1.5 shrink-0 bg-lime"></span><T value={s} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Block 2: Office ────────────────────────────────────────────
         Mobile: stacked or side-by-side on sm+ screens to preserve breathing room -->
    <div class="mt-16 border-t border-white/10 pt-10 md:mt-32 md:pt-16">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8 md:gap-14">
        <div class="w-full sm:w-2/5 md:w-[22rem] lg:w-[26rem] shrink-0">
          <Media
            src={y.office}
            alt={y.officeAlt}
            label={`Office — ${y.office}`}
            class="reveal-img aspect-[16/10] sm:aspect-[3/4] w-full"
          />
        </div>

        <div class="min-w-0 flex-1 border-l-2 border-lime pl-4 sm:pl-6 md:pl-10">
          <p class="label mb-2 text-sm sm:mb-3 md:mb-5"><T value={loc.label} /></p>
          <h3 class="font-display text-2xl leading-[1.05] uppercase sm:text-3xl md:text-5xl md:tracking-[-0.03em] lg:text-6xl">{loc.name}</h3>
          <address class="mt-3 max-w-xl text-sm not-italic text-muted sm:text-base md:mt-6 md:text-xl">{loc.address}</address>

          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 md:mt-8 md:gap-x-6">
            {loc.facilities.map((f) => (
              <li class="flex items-center gap-2 text-xs uppercase tracking-[0.1em] md:text-sm">
                <span aria-hidden="true" class="size-1.5 shrink-0 bg-lime"></span><T value={f} />
              </li>
            ))}
          </ul>

          <a
            href={loc.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-text mt-5 md:mt-10 inline-flex items-center gap-1.5"
          >
            <T value={loc.openMap} /><span aria-hidden="true">&nbsp;↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fluid sizing for Yus title on mobile that wraps safely without overflowing */
  @media (max-width: 767px) {
    .yus-title { font-size: clamp(2rem, 7.5vw, 3rem); line-height: 1; }
  }
</style>

---
import nav from '../data/navigation.json';
import T from './T.astro';
import LangToggle from './LangToggle.astro';

interface Props {
  vehicles?: any[];
}
const { vehicles = [] } = Astro.props;
---
<header
  id="site-header"
  data-scrolled="false"
  class="group fixed inset-x-0 top-0 z-50 transition-[background-color,border-color] duration-200 data-[scrolled=true]:border-b data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-ink/90 data-[scrolled=true]:backdrop-blur-md"
  style="top: 0; transform: translate3d(0, 0, 0); -webkit-transform: translate3d(0, 0, 0);"
>
  <div class="wrap flex h-16 items-center justify-between gap-4 transition-[height] duration-300 lg:h-20 lg:group-data-[scrolled=true]:h-16">
    <a href="#top" class="font-display text-lg font-semibold tracking-[0.14em]">
      BAIC <span class="font-normal text-muted">/ Yus</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-xs uppercase tracking-[0.14em] xl:gap-8">
        {nav.main.map((n) => (
          n.hasDropdown && vehicles.length > 0 ? (
            <li class="relative group/models">
              <a
                href={n.href}
                class="flex items-center gap-1.5 py-2 text-muted transition-colors hover:text-paper group-hover/models:text-paper"
              >
                <T value={n.label} />
                <span aria-hidden="true" class="text-[0.625rem] transition-transform duration-200 group-hover/models:rotate-180">▼</span>
              </a>

              <!-- Dropdown Menu -->
              <div class="invisible pointer-events-none absolute left-1/2 top-full -translate-x-1/2 pt-2 opacity-0 transition-all duration-200 group-hover/models:visible group-hover/models:pointer-events-auto group-hover/models:opacity-100">
                <div class="min-w-56 border border-white/15 bg-ink/95 p-2 shadow-2xl backdrop-blur-md">
                  <div class="border-b border-white/10 px-3 py-2">
                    <p class="text-[0.6875rem] font-medium tracking-[0.16em] text-muted"><T value={n.label} /></p>
                  </div>
                  <ul class="mt-1 space-y-0.5">
                    {vehicles.map((v, i) => (
                      <li>
                        <a
                          href={`#${v.slug}`}
                          class="group/item flex items-center justify-between px-3 py-2 text-xs transition-colors hover:bg-white/[0.06] hover:text-lime"
                        >
                          <span class="font-display font-medium text-paper group-hover/item:text-lime">{v.shortName}</span>
                          <span class="text-[0.6875rem] text-muted font-mono">{String(i + 1).padStart(2, '0')}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-1 border-t border-white/10 pt-1">
                    <a
                      href="#models"
                      class="block px-3 py-1.5 text-[0.6875rem] tracking-[0.12em] text-muted hover:text-lime"
                    >
                      <T value={{ en: 'View all models →', bm: 'Lihat semua model →' }} />
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a href={n.href} class="py-2 text-muted transition-colors hover:text-paper">
                <T value={n.label} />
              </a>
            </li>
          )
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:gap-5">
      <LangToggle />
      <button id="menu-btn" type="button" class="burger lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Sibling of the header: backdrop-filter on the header would trap a fixed child -->
<div id="mobile-menu" data-open="false" class="mobile-menu fixed inset-0 z-40 flex-col justify-between overflow-y-auto bg-ink px-6 pb-12 pt-24" style="padding-bottom: max(3rem, env(safe-area-inset-bottom));">
  <nav aria-label="Mobile">
    <ul class="divide-y divide-white/10">
      {nav.main.map((n) => (
        <li class="py-2">
          <a href={n.href} class="flex min-h-12 items-center font-display text-2xl sm:text-3xl uppercase tracking-tight text-paper transition-colors hover:text-lime">
            <T value={n.label} />
          </a>
          {n.hasDropdown && vehicles.length > 0 && (
            <ul class="mb-2 ml-3 mt-1 space-y-1 border-l-2 border-white/15 pl-4">
              {vehicles.map((v, i) => (
                <li>
                  <a href={`#${v.slug}`} class="flex min-h-10 items-center justify-between text-base font-display uppercase tracking-wider text-muted hover:text-lime">
                    <span>{v.shortName}</span>
                    <span class="text-xs text-lime font-mono">{String(i + 1).padStart(2, '0')}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="mt-8 border-t border-white/10 pt-6">
    <p class="label mb-2">BAIC Sungai Petani</p>
    <a href="#top" class="text-sm text-muted hover:text-paper">Yus · Sales Manager</a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 40));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setMenu(open: boolean) {
    menu?.setAttribute('data-open', String(open));
    btn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });
</script>

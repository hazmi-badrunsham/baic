// EN | BM. Behaviour lives in Layout.astro.
---
<div class="flex items-center font-display" role="group" aria-label="Language">
  <button type="button" class="lang-btn" data-set-lang="en" aria-pressed="true">EN</button>
  <span aria-hidden="true" class="text-muted/50">|</span>
  <button type="button" class="lang-btn" data-set-lang="bm" aria-pressed="false">BM</button>
</div>

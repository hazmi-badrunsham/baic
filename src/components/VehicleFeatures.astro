---
import T from './T.astro';
const { vehicle } = Astro.props as { vehicle: any };
const items: any[] = vehicle.features ?? [];
---
{items.length > 0 && (
  <ul class="grid gap-x-8 sm:grid-cols-2">
    {items.map((f) => (
      <li class="flex min-h-12 items-center gap-3 border-b border-white/10 py-3 text-sm uppercase tracking-[0.08em]">
        <span aria-hidden="true" class="grid size-5 shrink-0 place-items-center bg-lime text-[0.65rem] font-bold text-ink">✓</span>
        <span><T value={f} /></span>
      </li>
    ))}
  </ul>
)}

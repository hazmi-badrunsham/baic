---
import site from '../data/site.json';
import T from './T.astro';
import LangToggle from './LangToggle.astro';
const { vehicles } = Astro.props as { vehicles: any[] };
const a = site.advisor;
---
<footer class="border-t border-white/10 pb-24 pt-12 md:pb-12 md:pt-16">
  <div class="wrap">
    <!-- Top row: Identity & Navigation -->
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="#top" class="font-display text-2xl font-bold uppercase tracking-wider text-paper transition-colors hover:text-lime">
          BAIC <span class="font-normal text-muted">/ {a.location}</span>
        </a>
        <p class="mt-2 text-sm text-muted">
          <span class="text-paper">{a.name}</span> · <T value={a.role} />
        </p>
        <p class="text-xs text-muted/70">{a.company}</p>
      </div>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <!-- Vehicle quick links -->
        <nav aria-label="Vehicles navigation">
          <ul class="flex flex-wrap items-center gap-6 text-xs uppercase tracking-[0.14em]">
            {vehicles.map((v) => (
              <li>
                <a href={`#${v.slug}`} class="text-muted transition-colors hover:text-lime">
                  {v.shortName}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <span class="hidden h-4 w-px bg-white/15 sm:inline"></span>

        <!-- Lang toggle & Top -->
        <div class="flex items-center gap-4">
          <LangToggle />
          <a href="#top" class="inline-flex items-center gap-1 text-xs uppercase tracking-[0.14em] text-muted transition-colors hover:text-paper" aria-label="Back to top">
            <span>Top</span>
            <span aria-hidden="true">↑</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom row: Disclaimers & Copyright -->
    <div class="mt-12 border-t border-white/5 pt-8 text-xs text-muted/80">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl space-y-1.5 leading-relaxed">
          <p><T value={site.disclaimer.independent} /></p>
          <p><T value={site.disclaimer.footer} /></p>
        </div>
        <p class="shrink-0 text-muted/60">© {new Date().getFullYear()} {a.name} · {a.company}</p>
      </div>
    </div>
  </div>
</footer>

---
import site from '../data/site.json';
import T from './T.astro';
const m = site.more;
// In production only links with a URL are shown. In dev, empty ones show as "add URL" so you don't forget.
const dev = import.meta.env.DEV;
const links = m.links.filter((l) => l.url || dev);
---
{links.length > 0 && (
  <section data-ctx class="border-t border-white/10 py-14 md:py-20">
    <div class="wrap">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="label mb-2 text-sm"><span class="text-lime">- </span><T value={m.label} /></p>
          <h2 class="font-display text-2xl uppercase tracking-tight sm:text-3xl md:text-4xl reveal">
            <T value={m.title} />
          </h2>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 md:mt-10">
        {links.map((l) => (
          l.url ? (
            <a
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between border border-white/10 bg-white/[0.02] p-5 sm:p-6 transition-all hover:border-lime/60 hover:bg-white/[0.05]"
            >
              <div>
                <p class="label mb-1 text-xs text-muted">
                  {l.id === 'tiktok' ? 'TikTok' : 'Official'}
                </p>
                <p class="font-display text-lg uppercase tracking-tight text-paper transition-colors group-hover:text-lime sm:text-xl">
                  <T value={l.label} />
                </p>
              </div>
              <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center border border-white/15 text-lime transition-all group-hover:border-lime group-hover:bg-lime group-hover:text-ink">
                ↗
              </span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          ) : (
            <div class="flex items-center justify-between border border-white/10 p-5 text-muted/50 sm:p-6">
              <span class="font-display uppercase"><T value={l.label} /></span>
              <span class="label text-xs">Add URL in site.json</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
)}

---
import site from '../data/site.json';
import T from './T.astro';
const w = site.why;
---
<!-- Light editorial break between the vehicles and the contact section -->
<section data-ctx class="bg-paper py-20 text-ink md:py-32">
  <div class="wrap">
    <p class="label text-ink/60"><span class="text-ink">07</span> — <T value={w.label} /></p>
    <h2 class="title-lg mt-6"><T value={w.title} /></h2>

    <ol class="mt-12 md:mt-20">
      {w.points.map((p, i) => (
        <li class="reveal grid gap-2 border-t border-ink/20 py-6 last:border-b md:grid-cols-12 md:items-baseline md:gap-10 md:py-8">
          <span class="font-display text-sm text-ink/50 md:col-span-2">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display uppercase tracking-tight md:col-span-10" style="font-size:clamp(1.75rem,4.2vw,3.5rem);line-height:1"><T value={p} /></span>
        </li>
      ))}
    </ol>
  </div>
</section>

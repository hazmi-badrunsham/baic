---
import site from '../data/site.json';
import { fill, waUrl } from '../lib/wa';
import T from './T.astro';
import Lines from './Lines.astro';
import WhatsAppLink from './WhatsAppLink.astro';
const { vehicles } = Astro.props as { vehicles: any[] };
const c = site.contact;
const any = site.whatsapp.anyVehicle;
---
<section
  id="contact"
  data-ctx
  data-any-en={any.en}
  data-any-bm={any.bm}
  class="border-t border-white/10 py-16 md:py-24"
>
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-12 md:gap-12 lg:gap-16 items-start">
      <!-- Left Column: Title, Sub, Direct Action -->
      <div class="md:col-span-5">
        <p class="label mb-4 text-sm"><span class="text-lime">- </span><T value={c.label} /></p>
        <h2 class="font-display text-3xl uppercase leading-[1.05] tracking-tight sm:text-4xl md:text-5xl reveal">
          <Lines lines={c.lines} />
        </h2>
        <p class="mt-4 text-muted text-base md:text-lg"><T value={c.sub} /></p>

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <WhatsAppLink class="min-h-12 w-full sm:w-auto px-6 text-xs justify-center" label={site.cta.primary} />
          <a
            href={`tel:+${site.advisor.whatsappNumber}`}
            class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center gap-2 border border-white/15 bg-white/[0.03] px-5 text-xs font-display uppercase tracking-[0.1em] text-paper hover:border-lime hover:text-lime transition-colors"
          >
            <span class="text-muted"><T value={c.call} /></span>
            <span class="text-lime font-semibold">{site.advisor.phone}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Model Selector & Quick Inquiries -->
      <div class="md:col-span-7 border-t border-white/10 pt-8 md:border-t-0 md:border-l md:border-white/10 md:pl-10 lg:pl-14 md:pt-0">
        <div>
          <p id="pick-label" class="label mb-3"><T value={c.pick} /></p>
          <div role="group" aria-labelledby="pick-label" class="flex flex-wrap gap-2">
            <button type="button" class="pick-btn" data-pick="" aria-pressed="true"><T value={c.anyOption} /></button>
            {vehicles.map((v) => (
              <button type="button" class="pick-btn" data-pick={v.name} aria-pressed="false">{v.shortName}</button>
            ))}
          </div>
        </div>

        <div class="mt-8">
          <p class="label mb-3"><T value={site.yus.servicesLabel} /></p>
          <div class="grid gap-2.5 sm:grid-cols-2">
            {c.intents.map((it) => {
              const en = waUrl(fill(it.template.en, any.en));
              const bm = waUrl(fill(it.template.bm, any.bm));
              return (
                <a
                  href={en}
                  data-wa-en={en}
                  data-wa-bm={bm}
                  data-tpl-en={it.template.en}
                  data-tpl-bm={it.template.bm}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between gap-3 border border-white/10 bg-white/[0.02] p-4 text-xs sm:text-sm font-display uppercase tracking-wide text-paper transition-all hover:border-lime/60 hover:bg-white/[0.05]"
                >
                  <span class="transition-colors group-hover:text-lime"><T value={it.label} /></span>
                  <span aria-hidden="true" class="text-lime text-base transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pick-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 1.125rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-muted);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .pick-btn:hover {
    color: var(--color-paper);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .pick-btn[aria-pressed="true"] {
    background: var(--color-lime);
    color: var(--color-ink);
    border-color: var(--color-lime);
    font-weight: 600;
  }
</style>

<script>
  import { fill, waUrl } from '../lib/wa';

  const root = document.getElementById('contact');
  if (root) {
    const any = { en: root.dataset.anyEn!, bm: root.dataset.anyBm! };
    const links = root.querySelectorAll<HTMLAnchorElement>('a[data-tpl-en]');
    const picks = root.querySelectorAll<HTMLButtonElement>('[data-pick]');

    // Picking a model rewrites every WhatsApp link in this section (primary button + the options)
    const update = (name: string) => {
      const v = name ? { en: name, bm: name } : any;
      const bmOn = document.documentElement.dataset.ui === 'bm';
      links.forEach((a) => {
        const en = waUrl(fill(a.dataset.tplEn!, v.en));
        const bm = waUrl(fill(a.dataset.tplBm!, v.bm));
        a.dataset.waEn = en;
        a.dataset.waBm = bm;
        a.href = bmOn ? bm : en;
      });
      picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === name)));
    };
    picks.forEach((b) => b.addEventListener('click', () => update(b.dataset.pick || '')));
  }
</script>

---
import site from '../data/site.json';
import T from './T.astro';
const { vehicle } = Astro.props as { vehicle: any };
const p = vehicle.pricing;
const w = vehicle.warranty;
const L = site.labels;
---
{p && (
  <div>
    <p class="label"><T value={L.from} /></p>
    <p class="mt-2 font-display leading-none tracking-tight" style="font-size:clamp(3rem,8vw,6.5rem)">{p.from}</p>

    {w && (
      <dl class="mt-10 flex flex-wrap items-end gap-x-10 gap-y-4 border-t border-white/10 pt-6">
        <div class="flex flex-col-reverse gap-2">
          <dt class="label"><T value={L.years} /></dt>
          <dd class="font-display text-4xl leading-none">{w.years}</dd>
        </div>
        <div class="flex flex-col-reverse gap-2">
          <dt class="label">KM</dt>
          <dd class="font-display text-4xl leading-none">{w.km}</dd>
        </div>
        <p class="label pb-1 text-paper/70"><T value={L.warranty} /></p>
      </dl>
    )}

    {(p.otr || p.sumInsured) && (
      <dl class="mt-8 grid gap-3 text-sm">
        {p.otr && (
          <div class="flex justify-between gap-6 border-t border-white/5 pt-3">
            <dt class="text-muted"><T value={L.otr} /></dt><dd>{p.otr}</dd>
          </div>
        )}
        {p.sumInsured && (
          <div class="flex justify-between gap-6 border-t border-white/5 pt-3">
            <dt class="text-muted"><T value={L.sumInsured} /></dt><dd>{p.sumInsured}</dd>
          </div>
        )}
      </dl>
    )}

    <p class="mt-6 text-xs text-muted"><T value={site.disclaimer.pricing} /></p>
  </div>
)}

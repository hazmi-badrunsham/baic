---
// Light "price card" so the price is the most visible block in each chapter.
import site from '../data/site.json';
import T from './T.astro';
import WhatsAppLink from './WhatsAppLink.astro';
const { vehicle, ask } = Astro.props as { vehicle: any; ask: { en: string; bm: string } };
const p = vehicle.pricing;
const w = vehicle.warranty;
const L = site.labels;
const darkBtn = '!bg-ink !text-paper hover:!bg-lime hover:!text-ink w-full sm:w-auto';
---
<div class="bg-paper p-6 text-ink md:p-10">
  {p ? (
    <div class="grid gap-8 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-7">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink/60"><T value={L.from} /> · {vehicle.name}</p>
        <p class="mt-2 font-display leading-[0.9] tracking-tight" style="font-size:clamp(3rem,8vw,6.5rem)">{p.from}</p>

        {(p.otr || p.sumInsured) && (
          <dl class="mt-8 grid max-w-lg gap-0 text-sm">
            {p.otr && (
              <div class="flex justify-between gap-6 border-t border-ink/15 py-3">
                <dt class="text-ink/60"><T value={L.otr} /></dt><dd class="font-medium">{p.otr}</dd>
              </div>
            )}
            {p.sumInsured && (
              <div class="flex justify-between gap-6 border-t border-ink/15 py-3">
                <dt class="text-ink/60"><T value={L.sumInsured} /></dt><dd class="font-medium">{p.sumInsured}</dd>
              </div>
            )}
          </dl>
        )}
      </div>

      <div class="flex flex-col justify-between gap-8 md:col-span-5 md:border-l md:border-ink/15 md:pl-10">
        {w && (
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.18em] text-ink/60"><T value={L.warranty} /></p>
            <div class="mt-3 flex items-end gap-8">
              <p class="font-display text-5xl leading-none">{w.years}<span class="ml-2 text-xs uppercase tracking-[0.18em] text-ink/60"><T value={L.years} /></span></p>
              <p class="font-display text-5xl leading-none">{w.km}<span class="ml-2 text-xs uppercase tracking-[0.18em] text-ink/60">KM</span></p>
            </div>
          </div>
        )}
        <div>
          <WhatsAppLink vehicle={vehicle.name} label={ask} class={darkBtn} />
          <p class="mt-4 text-xs text-ink/60"><T value={site.disclaimer.pricing} /></p>
        </div>
      </div>
    </div>
  ) : (
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-lg text-lg"><T value={L.pending} /></p>
      <WhatsAppLink vehicle={vehicle.name} label={ask} class={darkBtn} />
    </div>
  )}
</div>

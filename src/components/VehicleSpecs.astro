---
import site from '../data/site.json';
import T from './T.astro';
const { vehicle } = Astro.props as { vehicle: any; rugged?: boolean };
const stats: any[] = vehicle.keyStats ?? [];
const labels = site.labels.specs as Record<string, { en: string; bm: string }>;
// Null / missing values are skipped, so a half-filled vehicle (BJ30) still renders cleanly
const rows = Object.entries(vehicle.specs ?? {}).filter(([k, v]) => v && labels[k]);
---
{stats.length > 0 && (
  <dl class="grid grid-cols-2 gap-px overflow-hidden border border-white/10 bg-white/10 md:grid-cols-5">
    {stats.map((s, i) => (
      <div class:list={['flex flex-col-reverse justify-end gap-3 bg-ink p-5 md:p-7', i === stats.length - 1 && stats.length % 2 === 1 && 'col-span-2 md:col-span-1']}>
        <dt class="label text-paper/70"><T value={s.unit} /></dt>
        <dd class="font-display leading-none tracking-tight" style="font-size:clamp(2.25rem,5vw,4.5rem)">{s.value}</dd>
      </div>
    ))}
  </dl>
)}

{rows.length > 0 && (
  <details class="group mt-6 border border-white/10 bg-white/[0.02]">
    <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between px-5 font-display text-sm uppercase tracking-[0.12em] hover:text-lime md:px-7">
      <span><T value={site.labels.fullSpecs} /> <span class="text-muted">({rows.length})</span></span>
      <span aria-hidden="true" class="grid size-8 place-items-center border border-white/20 text-lg text-lime transition-transform group-open:rotate-45">+</span>
    </summary>
    <dl class="grid gap-x-12 px-5 pb-6 md:grid-cols-2 md:px-7">
      {rows.map(([k, val]) => (
        <div class="flex justify-between gap-6 border-t border-white/10 py-3 text-sm">
          <dt class="text-muted"><T value={labels[k]} /></dt>
          <dd class="text-right">{val as string}</dd>
        </div>
      ))}
    </dl>
  </details>
)}

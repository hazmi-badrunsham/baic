<file path="src/components/Hero.astro">
---
import site from '../data/site.json';
import T from './T.astro';
import WhatsAppLink from './WhatsAppLink.astro';
const h = site.hero;
---
<section id="top" class="relative isolate h-svh min-h-[560px] overflow-hidden bg-ink">
  <div class="hero-wrap media bg-ink-2" data-media data-label="BAIC hero video">
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover opacity-0"
      data-hero-video
      data-video-landscape={h.videoLandscape}
      data-video-portrait={h.videoPortrait}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <div class="hero-shade absolute inset-0"></div>
  </div>

  <div class="hero-copy wrap relative z-10 flex h-full flex-col justify-end pb-14 lg:justify-between lg:px-10 lg:pb-14 lg:pt-32">
    <p class="label hidden text-paper/60 lg:block"><T value={h.eyebrow} /></p>

    <div>
      <p class="label text-paper/70 lg:hidden"><T value={h.eyebrow} /></p>
      <h1 class="title-xl mt-4 max-w-[12ch] lg:mt-0" style="font-size:clamp(2.75rem,6.4vw,7.5rem)"><T value={h.title} /></h1>
      <p class="mt-5 max-w-sm text-base text-paper/80 md:text-lg"><T value={h.description} /></p>
      <div class="mt-8">
        <WhatsAppLink label={site.cta.primary} />
      </div>
    </div>

    <a href="#yus" class="label mt-10 hidden items-center gap-4 hover:text-paper lg:flex">
      <span class=""></span><T value={h.scroll} />
    </a>
  </div>
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = !!(navigator as any).connection?.saveData;
    const desktop = window.matchMedia('(min-width: 1024px)');
    v.muted = true;
    v.addEventListener('playing', () => { v.classList.add('is-playing'); v.style.opacity = '1'; });
    const updateSource = () => {
      const source = desktop.matches ? v.dataset.videoLandscape : v.dataset.videoPortrait;
      if (reduce || saveData || !source) {
        v.style.opacity = '1';
        return;
      }
      if (v.getAttribute('src') === source) return;
      v.classList.remove('is-playing');
      v.style.opacity = '0';
      v.src = source;
      v.load();
      v.play().catch(() => { v.style.opacity = '1'; });
    };
    updateSource();
    desktop.addEventListener('change', updateSource);
  }
</script>
</file>


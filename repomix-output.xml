<file path="src/pages/index.astro">
---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MeetYus from '../components/MeetYus.astro';
import Models from '../components/Models.astro';
import VehicleSection from '../components/VehicleSection.astro';
import WhyBaic from '../components/WhyBaic.astro';
import Contact from '../components/Contact.astro';
import MoreFromYus from '../components/MoreFromYus.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import data from '../data/vehicles.json';

const vehicles = data.vehicles;
---
<Layout>
  <Header />
  <main>
    <Hero />
    <MeetYus vehicles={vehicles} />
    <Models vehicles={vehicles} />
    {vehicles.map((v, i) => <VehicleSection vehicle={v} number={4 + i} />)}
    <WhyBaic />
    <Contact vehicles={vehicles} />
    <MoreFromYus />
  </main>
  <Footer vehicles={vehicles} />
  <StickyWhatsApp />
</Layout>
</file>

<file path="src/styles/global.css">
@import "tailwindcss";

@theme {
  --color-ink: #0A0A0A;
  --color-ink-2: #111111;
  --color-paper: #F5F5F0;
  --color-muted: #A1A1A1;
  --color-lime: #C8FF00;

  --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
}

@layer base {
  html {
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-sans);
    scroll-behavior: smooth;
    scroll-padding-top: 4.5rem;
    -webkit-text-size-adjust: 100%;
  }
  body { overflow-x: hidden; }
  h1, h2, h3, h4 { font-family: var(--font-display); letter-spacing: -0.02em; }
  :focus-visible { outline: 2px solid var(--color-lime); outline-offset: 3px; }
  ::selection { background: var(--color-lime); color: var(--color-ink); }
  summary::-webkit-details-marker { display: none; }
}

html[data-ui="en"] [data-lang="bm"],
html[data-ui="bm"] [data-lang="en"] { display: none !important; }

@layer components {
  .wrap { margin-inline: auto; max-width: 90rem; padding-inline: 1.25rem; }
  @media (min-width: 768px) { .wrap { padding-inline: 2.5rem; } }

  .label {
    font-size: .75rem; font-weight: 500; letter-spacing: .18em;
    text-transform: uppercase; color: var(--color-muted);
  }
  .title-xl {
    font-size: clamp(2.75rem, 8vw, 7.5rem); line-height: .92; letter-spacing: -.035em;
    text-transform: uppercase; text-wrap: balance;
  }
  .title-lg {
    font-size: clamp(2.25rem, 6vw, 5rem); line-height: .95; letter-spacing: -.03em;
    text-transform: uppercase; text-wrap: balance;
  }
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Buttons: white by default, lime only on hover */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0 1.5rem;
    background: var(--color-paper); color: var(--color-ink);
    font-family: var(--font-display); font-weight: 600; font-size: .8125rem;
    letter-spacing: .1em; text-transform: uppercase;
    transition: background-color .2s ease;
  }
  .btn:hover { background: var(--color-lime); }
  .btn-text {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-display); font-weight: 500; font-size: .8125rem;
    letter-spacing: .1em; text-transform: uppercase;
    border-bottom: 1px solid var(--color-lime); transition: color .2s ease;
  }
  .btn-text:hover { color: var(--color-lime); }

  .lang-btn {
    min-width: 36px; min-height: 44px; padding: 0 .35rem;
    color: var(--color-muted); font-size: .8125rem; letter-spacing: .1em;
  }
  .lang-btn[aria-pressed="true"] { color: var(--color-paper); box-shadow: inset 0 -2px 0 var(--color-lime); }

  .pick {
    min-height: 44px; color: var(--color-muted); font-size: .875rem;
    border-bottom: 2px solid transparent; transition: color .2s ease;
  }
  .pick:hover { color: var(--color-paper); }
  .pick[aria-pressed="true"] { color: var(--color-paper); border-bottom-color: var(--color-lime); }

  .burger { position: relative; width: 44px; height: 44px; }
  .burger span {
    position: absolute; left: 11px; right: 11px; height: 2px;
    background: var(--color-paper); transition: transform .25s ease, top .25s ease;
  }
  .burger span:first-child { top: 18px; }
  .burger span:last-child { top: 25px; }
  .burger[aria-expanded="true"] span:first-child { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child { top: 21px; transform: rotate(-45deg); }
  .mobile-menu { display: none; }
  .mobile-menu[data-open="true"] { display: flex; }
  @media (min-width: 1024px) { .mobile-menu { display: none !important; } }

  /* Media slots: dashed placeholder when the real file is missing */
  .media[data-missing] img { display: none; }
  .media[data-missing]::after {
    content: attr(data-label);
    position: absolute; inset: .75rem; display: grid; place-items: center; padding: 1rem;
    border: 1px dashed rgb(255 255 255 / .14);
    font: 500 .6875rem/1.6 var(--font-display); letter-spacing: .16em; text-transform: uppercase;
    text-align: center; color: #6b6b6b; word-break: break-all;
  }
  .media video { opacity: 0; transition: opacity 1s ease; }
  .media video.is-playing { opacity: 1; }

  /* Hero: match the video orientation to the viewport and keep copy readable over the footage. */
  .hero-wrap { position: absolute; inset: 0; }
  .hero-shade { background: linear-gradient(to top, #0A0A0A 0%, rgb(10 10 10 / .55) 38%, rgb(10 10 10 / .1) 70%, rgb(10 10 10 / .45) 100%); }
  .hero-video { transition: opacity 1.2s ease; }
  .hero-video.is-playing { animation: hero-settle 9s ease-out forwards; }
  @keyframes hero-settle { from { transform: scale(1.05); } to { transform: scale(1); } }
  @media (min-width: 1024px) {
    .hero-shade {
      background:
        linear-gradient(90deg, rgb(10 10 10 / .82) 0%, rgb(10 10 10 / .62) 30%, transparent 78%),
        linear-gradient(0deg, rgb(10 10 10 / .38) 0%, transparent 48%);
    }
  }

  /* Sticky WhatsApp */
  #wa-sticky { transform: translateY(120%); opacity: 0; pointer-events: none; transition: transform .4s ease, opacity .4s ease; }
  #wa-sticky[data-visible="true"] { transform: none; opacity: 1; pointer-events: auto; }
}

/* Reveals only apply when JS is running */
.js .reveal { opacity: 0; transform: translateY(14px); transition: opacity .8s ease, transform .8s ease; }
.js .reveal.is-in { opacity: 1; transform: none; }
.js .reveal-img { opacity: 0; clip-path: inset(6% 0 0 0); transition: opacity 1s ease, clip-path 1.1s cubic-bezier(.2,.7,.2,1); }
.js .reveal-img.is-in { opacity: 1; clip-path: inset(0); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .js .reveal, .js .reveal-img { opacity: 1; transform: none; clip-path: none; transition: none; }
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
</file>

